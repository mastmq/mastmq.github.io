---
import Mark from './Mark.astro';
import { site, badges } from '../data/site';

// The banner states the name, the pitch and the mascot, so nothing here
// repeats them in text. It swaps with the colour scheme rather than picking
// one and sitting in a mismatched block on the other: each variant's ground
// is within a few levels of the page background it lands on, so the image
// has no visible edge.
//
// The page still needs a heading a screen reader and a search engine can
// read, and alt text on a masthead is not it, so the h1 is present and
// visually hidden.
---
<header class="hero">
  <nav class="hero-nav wrap">
    <a class="hero-nav-brand" href="/">
      <Mark size={34} id="nav" />
      <span>mast</span>
    </a>
    <div class="hero-nav-links">
      <a href={site.migrationGuide}>Migrating from EMQX</a>
      <a href={site.org}>Organization</a>
      <a href={site.repo}>GitHub</a>
    </div>
  </nav>

  <div class="wrap">
    <h1 class="sr-only">{site.name} — {site.tagline}. {site.blurb}</h1>

    <picture>
      <source media="(prefers-color-scheme: dark)" srcset="/assets/banner.png 1x, /assets/banner@2x.png 2x" />
      <img
        class="banner"
        src="/assets/banner-light.png"
        srcset="/assets/banner-light.png 1x, /assets/banner-light@2x.png 2x"
        alt={`${site.name} — ${site.tagline}`}
        width="1280"
        height="400"
        fetchpriority="high"
      />
    </picture>

    <div class="badges">
      {badges.map((b) => <span class="badge">{b}</span>)}
    </div>
    <div class="cta">
      <a class="btn btn-primary" href={site.repo}>Source</a>
      <a class="btn btn-ghost" href={site.migrationGuide}>Migrating from EMQX</a>
    </div>
  </div>
</header>
