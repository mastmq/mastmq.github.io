---
import Mark from './Mark.astro';
import { site, badges, sections, stats } from '../data/site';

// The masthead is text, not the banner. The banner is an image of text: on
// a phone it shrank to a 6px tagline, it could not reflow, and the h1 had
// to be hidden behind it. It is still the social card, in Base.astro, which
// is the one place an image of text is the right answer.
const nav = Object.values(sections).flatMap((x) => ('nav' in x ? [{ id: x.id, label: x.nav }] : []));
---
<header class="hero">
  <nav class="hero-nav wrap" aria-label="Sections">
    <a class="hero-nav-brand" href="/">
      <Mark size={34} id="nav" />
      <span>{site.name}</span>
    </a>
    <div class="hero-nav-links">
      {nav.map((n) => <a href={`#${n.id}`}>{n.label}</a>)}
      <a href={site.repo}>GitHub</a>
    </div>
    {/* No JavaScript framework on the page, so the phone menu is a
        <details>: it opens and closes without a script, and the one line
        below only closes it after a link is followed. */}
    <details class="nav-menu">
      <summary aria-label="Menu">Menu</summary>
      <div class="nav-menu-links">
        {nav.map((n) => <a href={`#${n.id}`}>{n.label}</a>)}
        <a href={site.repo}>GitHub</a>
      </div>
    </details>
    <script is:inline>
      document.querySelectorAll('.nav-menu a').forEach((a) =>
        a.addEventListener('click', () => a.closest('details').removeAttribute('open')));
    </script>
  </nav>

  <div class="wrap hero-grid">
    <div class="hero-text">
      <h1>{site.tagline}</h1>
      <p class="hero-pitch">{site.pitch}</p>
      <div class="badges">
        {badges.map((b) => <span class="badge">{b}</span>)}
      </div>
      <div class="cta">
        <a class="btn btn-primary" href={`#${sections.run.id}`}>Get started</a>
        <a class="btn btn-ghost" href={site.repo}>Source on GitHub</a>
        <a class="btn btn-ghost" href={`#${sections.emqx.id}`}>Coming from EMQX</a>
      </div>
    </div>
    <img
      class="mascot"
      src="/assets/mascot.png"
      alt=""
      width="512"
      height="512"
      fetchpriority="high"
    />
  </div>

  <div class="wrap">
    <ul class="stats">
      {stats.map((x) => (
        <li>
          <a href={`#${sections.results.id}`}>
            <strong>{x.value}</strong>
            <span>{x.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>
