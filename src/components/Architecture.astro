---
// Drawn inline rather than shipped as an .svg file so it takes its colours
// from the same custom properties as the rest of the page: an <img> cannot
// see them, and a picture drawn for the light page sits as a white slab on
// the dark one. The numbered badges match the steps listed under it, which
// are HTML so they wrap and a screen reader gets them as text.
//
// It scrolls sideways on a phone instead of shrinking. Scaled to 360px the
// labels came out at under five pixels.
const edges = [125, 210, 295];
---
<div class="figure-scroll">
  <svg
    class="arch"
    viewBox="0 0 980 392"
    role="img"
    aria-labelledby="arch-title arch-desc"
  >
    <title id="arch-title">How a mast cluster is put together</title>
    <desc id="arch-desc">
      Devices connect over MQTT to a tier of stateless edge nodes. Edges join three core nodes as
      NATS leaf nodes. The cores hold four replicated JetStream assets: the mast_qos stream, the
      mast_offline stream, and the mast_sessions and mast_retained key-value buckets. A queuer on
      each core copies messages for absent sessions from mast_qos into mast_offline.
    </desc>

    <defs>
      <marker id="arch-head" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path class="arch-arrowhead" d="M0 0 L10 5 L0 10 z" />
      </marker>
    </defs>

    <!-- tier labels -->
    <text class="arch-tier" x="24" y="40">Devices</text>
    <text class="arch-tier" x="200" y="40">Edge tier · stateless, scales out</text>
    <text class="arch-tier" x="516" y="40">Core tier · Raft, every asset on all three</text>

    <!-- devices -->
    <rect class="arch-box" x="24" y="103" width="140" height="44" rx="8" />
    <text class="arch-label" x="94" y="130" text-anchor="middle">device · MQTT 5</text>
    <rect class="arch-box" x="24" y="188" width="140" height="44" rx="8" />
    <text class="arch-label" x="94" y="215" text-anchor="middle">device · MQTT 3.1.1</text>
    <rect class="arch-box arch-away" x="24" y="273" width="140" height="44" rx="8" />
    <text class="arch-muted" x="94" y="292" text-anchor="middle">asleep</text>
    <text class="arch-muted" x="94" y="308" text-anchor="middle">session kept</text>

    <!-- edge tier -->
    <rect class="arch-tierbox" x="200" y="56" width="260" height="312" rx="14" />
    {edges.map((cy, i) => (
      <>
        <rect class="arch-box" x="220" y={cy - 32} width="220" height="64" rx="10" />
        <text class="arch-label arch-strong" x="236" y={cy - 6}>edge-{i}</text>
        <text class="arch-muted" x="236" y={cy + 14}>MQTT listeners · bridge</text>
      </>
    ))}
    <line class="arch-link" x1="164" y1="125" x2="218" y2="125" marker-end="url(#arch-head)" />
    <line class="arch-link" x1="164" y1="210" x2="218" y2="210" marker-end="url(#arch-head)" />
    <line class="arch-link arch-dashed" x1="164" y1="295" x2="218" y2="295" marker-end="url(#arch-head)" />

    <!-- leaf links -->
    <text class="arch-muted" x="488" y="84" text-anchor="middle">leaf links</text>
    {edges.map((cy) => (
      <line class="arch-link" x1="442" y1={cy} x2="534" y2={cy} marker-start="url(#arch-head)" marker-end="url(#arch-head)" />
    ))}

    <!-- core tier -->
    <rect class="arch-tierbox" x="516" y="56" width="448" height="312" rx="14" />
    {[536, 678, 820].map((x, i) => (
      <>
        <rect class="arch-box" x={x} y="76" width="128" height="50" rx="10" />
        <text class="arch-label arch-strong" x={x + 64} y="98" text-anchor="middle">core-{i}</text>
        <text class="arch-muted" x={x + 64} y="116" text-anchor="middle">NATS · queuer</text>
      </>
    ))}
    <line class="arch-mesh" x1="664" y1="101" x2="678" y2="101" />
    <line class="arch-mesh" x1="806" y1="101" x2="820" y2="101" />
    <text class="arch-muted" x="740" y="150" text-anchor="middle">routes mesh the cores; JetStream replicates to all three</text>

    <rect class="arch-store" x="536" y="170" width="176" height="78" rx="10" />
    <text class="arch-label arch-strong" x="552" y="194">mast_qos</text>
    <text class="arch-muted" x="552" y="214">stream · QoS 1/2, stored</text>
    <text class="arch-muted" x="552" y="232">before the PUBACK</text>

    <rect class="arch-store" x="772" y="170" width="176" height="78" rx="10" />
    <text class="arch-label arch-strong" x="788" y="194">mast_offline</text>
    <text class="arch-muted" x="788" y="214">stream · one subject per</text>
    <text class="arch-muted" x="788" y="232">session, newest 100</text>

    <rect class="arch-store" x="536" y="270" width="176" height="78" rx="10" />
    <text class="arch-label arch-strong" x="552" y="294">mast_sessions</text>
    <text class="arch-muted" x="552" y="314">KV · subscriptions, and</text>
    <text class="arch-muted" x="552" y="332">whether anyone holds it</text>

    <rect class="arch-store" x="772" y="270" width="176" height="78" rx="10" />
    <text class="arch-label arch-strong" x="788" y="294">mast_retained</text>
    <text class="arch-muted" x="788" y="314">KV · read with batched</text>
    <text class="arch-muted" x="788" y="332">direct gets, no consumer</text>

    <!-- the queuer: mast_qos → mast_offline, for sessions marked away -->
    <line class="arch-link arch-hot" x1="712" y1="209" x2="770" y2="209" marker-end="url(#arch-head)" />
    <text class="arch-muted" x="742" y="198" text-anchor="middle">queuer</text>
    <path class="arch-link arch-dashed" d="M712 292 C 742 292, 742 250, 742 214" />
    <text class="arch-muted" x="748" y="262">away?</text>

    <!-- step badges, matching the list under the figure -->
    {[
      { n: 1, x: 488, y: 125 },
      { n: 2, x: 488, y: 210 },
      { n: 3, x: 742, y: 190 },
      { n: 4, x: 488, y: 295 },
    ].map((b) => (
      <>
        <circle class="arch-badge" cx={b.x} cy={b.y - 14} r="10" />
        <text class="arch-badge-n" x={b.x} y={b.y - 10} text-anchor="middle">{b.n}</text>
      </>
    ))}
  </svg>
</div>
