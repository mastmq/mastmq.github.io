---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Cards from '../components/Cards.astro';
import Code from '../components/Code.astro';
import Architecture from '../components/Architecture.astro';
import {
  site, sections as s, why, alternatives, pillars, architecture, flow,
  run, drills, results, emqx, status, repos,
} from '../data/site';

const title = `${site.name} — multi-tenant MQTT broker on core NATS`;
const description =
  'An open-source multi-tenant MQTT broker built on core NATS. MQTT 5, shared subscriptions, tenant isolation, free clustering, no JVM, one binary.';

// The four drills that carry the claim are shown; the rest, the
// regressions among them, are one click away and named in the note under
// the table, so hiding them cannot read as hiding them.
const featured = drills.rows.filter((r) => 'featured' in r);
const rest = drills.rows.filter((r) => !('featured' in r));

// The page reads as an argument: what is missing elsewhere, how mast fills
// it, how to run it, the evidence that it holds, then what it is not yet.
---

<Base title={title} description={description}>
  <Hero />

  <main>
    <Section {...s.why} lede={why.lede}>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Broker</th><th>The catch</th></tr>
          </thead>
          <tbody>
            {alternatives.map((a) => (
              <tr><td>{a.broker}</td><td>{a.catch}</td></tr>
            ))}
            <tr class="mast-row">
              <td class="yes">{site.name}</td>
              <td>{why.mast}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </Section>

    <Section {...s.design}>
      <Cards items={pillars} />
    </Section>

    <Section {...s.architecture} lede={architecture.lede}>
      <Architecture />
      <ol class="steps">
        {flow.map((step) => <li>{step}</li>)}
      </ol>
    </Section>

    <Section {...s.run} lede={run.lede}>
      <Code lines={run.roles} label="The three roles" />
      <p class="note">{run.note}</p>
      <div class="cards install">
        {run.install.map((i) => (
          <div class="card">
            <h3>{i.title}</h3>
            <p>{i.body}</p>
            <Code lines={i.lines} label={`Install: ${i.title}`} />
            <a class="more" href={i.url}>{i.link} →</a>
          </div>
        ))}
      </div>
    </Section>

    <Section
      {...s.results}
      lede={`Drills on ${drills.shape}, with nodes killed by SIGKILL and restarted, run on ${drills.when}. Every message carries an id, and the drill counts which ones arrived.`}
    >
      <table class="results">
        <thead>
          <tr><th>Drill</th><th>Before</th><th>After</th></tr>
        </thead>
        <tbody>
          {featured.map((r) => (
            <tr><td data-label="Drill">{r.drill}</td><td data-label="Before">{r.before}</td><td data-label="After">{r.after}</td></tr>
          ))}
        </tbody>
      </table>
      <details class="more-rows">
        <summary>The other {rest.length} drills, including the one that did not improve</summary>
        <table class="results">
          <thead>
            <tr><th>Drill</th><th>Before</th><th>After</th></tr>
          </thead>
          <tbody>
            {rest.map((r) => (
              <tr><td data-label="Drill">{r.drill}</td><td data-label="Before">{r.before}</td><td data-label="After">{r.after}</td></tr>
            ))}
          </tbody>
        </table>
      </details>
      <p class="note">{results.note} <a href={site.deliveryGuide}>Delivery guarantees</a> has the detail.</p>
    </Section>

    <Section {...s.emqx} lede={emqx.lede}>
      <Code lines={emqx.config} label="EMQX-compatible auth configuration" />
      <p class="note">{emqx.note} <a href={site.migrationGuide}>Read the migration guide →</a></p>
    </Section>

    <Section {...s.status} lede={status.lede}>
      <p>{status.gaps} <a href={site.parityIssues}>Open parity issues →</a></p>
      <p class="note">{status.limit} <a href={site.deliveryGuide}>Delivery guarantees</a> sets out what each QoS promises hop by hop, what it costs, and where it still falls short.</p>
    </Section>

    <Section {...s.repos} lede={`Everything lives under the ${site.org.replace('https://', '')} organization, under ${site.license}.`}>
      <Cards items={repos.map((r) => ({ title: r.name, body: r.what, url: r.url }))} />
    </Section>
  </main>
</Base>
