---
import '../styles/global.css';
import { site } from '../data/site';

const { title, description } = Astro.props as { title: string; description: string };
const ogImage = new URL('/assets/banner.png', Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/assets/mark.png" />
    <link rel="canonical" href={Astro.site} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
    <footer>
      <div class="wrap">
        Apache 2.0 &middot; <a href={site.org}>github.com/mastmq</a>
      </div>
    </footer>
  </body>
</html>
